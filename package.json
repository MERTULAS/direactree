{
  "name": "direactree",
  "version": "0.3.0",
  "description": "React UI component library for directory tree",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "browser": "dist/index.mjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/MERTULAS/direactree.git"
  },
  "homepage": "https://docs.mertulas.dev/docs/direactree/",
  "bugs": {
    "url": "https://github.com/MERTULAS/direactree/issues"
  },
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "next": [
        "dist/next.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "require": "./dist/next.cjs",
      "import": "./dist/next.mjs"
    },
    "./direactree.css": "./dist/direactree.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "start-storybook -p 6006",
    "test": "jest --runInBand && node test/ensure-react17.js && jest --config jest.react17.config.js --runInBand",
    "test:react17": "node test/ensure-react17.js && jest --config jest.react17.config.js --runInBand",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook"
  },
  "keywords": [
    "react",
    "component",
    "ui",
    "directory",
    "tree",
    "nextjs",
    "react-ui",
    "directory-tree"
  ],
  "author": "Mert ULAS",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.18.6",
    "@babel/preset-env": "^7.18.6",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@rollup/plugin-commonjs": "^22.0.1",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@storybook/addon-actions": "^6.5.9",
    "@storybook/addon-essentials": "^6.5.9",
    "@storybook/addon-interactions": "^6.5.9",
    "@storybook/addon-links": "^6.5.9",
    "@storybook/builder-webpack5": "^6.5.9",
    "@storybook/manager-webpack5": "^6.5.9",
    "@storybook/react": "^6.5.9",
    "@storybook/testing-library": "^0.0.13",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "babel-loader": "^8.2.5",
    "jest": "^28.1.3",
    "jest-environment-jsdom": "^28.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^2.77.0",
    "rollup-plugin-css-only": "^4.5.2",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.32.1",
    "typescript": "^4.7.4"
  }
}
